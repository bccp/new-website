---
import BaseLayout from "../layouts/BaseLayout.astro";

const cards = [
  {
    title: "Research",
    href: "/research/",
    text: "Projects led by BCCP scientists and collaborations with substantial BCCP involvement."
  },
  {
    title: "People",
    href: "/people/",
    text: "Faculty, scientists, postdocs, students, visitors, alumni, and administrators."
  },
  {
    title: "Events",
    href: "/events/",
    text: "Seminars, lunches, workshops, and center events."
  },
  {
    title: "Jobs",
    href: "/jobs/",
    text: "Postdoctoral fellowships and other opportunities in Berkeley cosmology."
  },
  {
    title: "Visiting",
    href: "/visiting/",
    text: "Information about the BCCP visitor program and past visitors."
  },
  {
    title: "Donate",
    href: "/donate/",
    text: "Ways to support research, visitors, workshops, and students at BCCP."
  }
];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (path: string) => `${base}${path}`;
---

<BaseLayout
  title="Berkeley Center for Cosmological Physics"
  description="BCCP focuses on understanding the origin and evolution of the universe through observations, experiments, theory, and simulation."
>
  <section class="section hero">
    <div>
      <div class="eyebrow">Berkeley Center for Cosmological Physics</div>
      <h1>Understanding the origin and evolution of the universe.</h1>
      <p class="lead">
        BCCP is a joint center of <a href="https://www.berkeley.edu/">UC Berkeley</a> and <a href="https://www.lbl.gov/">Lawrence Berkeley National Laboratory</a>,
        bringing together researchers to answer fundamental questions in cosmology.
      </p>
      <p>
        Our programs define the observations, experiments, concepts, and simulations needed to do so.
        By combining experiment, computation, and theory, we aim to build an accurate, reliable model
        of the cosmos and test it against observations.
      </p>
    </div>
    <figure class="hero-media">
      <img src={withBase("/images/campanile-sunset.jpg")} alt="The UC Berkeley Campanile at sunset, rising above the campus and trees with the hazy San Francisco Bay and a bridge in the distance" />
    </figure>
  </section>

  <section class="section">
    <div class="quick-grid">
      {cards.map((card) => (
        <a class="quick-card" href={withBase(card.href)}>
          <h2>{card.title}</h2>
          <p>{card.text}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
